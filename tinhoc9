/* ==================== */
/* CÀI ĐẶT CHUNG */
/* ==================== */

* {
    box-sizing: border-box;
}

body {
    background-color: white;
    color: black;

    font-family: Arial, sans-serif; /* Hoặc font bạn chọn */
    text-transform: uppercase;
    margin: 0;
    padding: 0;

    text-align: center;
}


/* ==================== */
/* MÀN HÌNH GIỚI THIỆU */
/* ==================== */

.home {
    min-height: 100vh;

    display: flex;
    flex-direction: column;

    justify-content: center;
    align-items: center;

    padding: 30px;
}


.home h1 {
    font-size: 48px;

    max-width: 900px;

    margin-bottom: 20px;
}


.home p {
    font-size: 20px;

    color: black;

    max-width: 700px;

    line-height: 1.6;
}


/* ==================== */
/* BUTTON */
/* ==================== */

button {
    background-color: #007bff;

    color: white;

    border: none;

    padding: 14px 28px;

    font-size: 18px;

    border-radius: 10px;

    cursor: pointer;

    margin-top: 20px;

    transition: 0.3s;
}


button:hover {
    transform: scale(1.05);

    background-color: #3b82f6;
}


/* ==================== */
/* DANH SÁCH NGHỀ */
/* ==================== */

.jobs {
    display: none;

    min-height: 100vh;

    padding: 50px 30px;
}


.jobs > h1 {
    font-size: 40px;

    margin-bottom: 50px;
}


/* ==================== */
/* KHUNG 4 NGHỀ */
/* ==================== */

.job-container {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 25px;

    max-width: 900px;

    margin: 0 auto;
}


/* ==================== */
/* THẺ NGHỀ */
/* ==================== */

.job-card {
    background-color:  #CCFFCC;

    padding: 30px;

    border-radius: 20px;

    border-color: #3B82F6;

    text-align: center;

    transition: 0.3s;
}


.job-card:hover {
    transform: translateY(-8px);

    background-color: #263449;
}


.job-icon {
    font-size: 60px;
}


.job-card h2 {
    font-size: 25px;

    margin: 15px 0;
}


.job-card p {
    color: #cbd5e1;

    font-size: 16px;

    line-height: 1.6;
}


/* ==================== */
/* MÀN HÌNH CHI TIẾT */
/* ==================== */

.job-detail {
    display: none;

    min-height: 100vh;

    justify-content: center;
    align-items: center;

    padding: 40px 20px;
}


/* ==================== */
/* HỘP CHI TIẾT */
/* ==================== */

.detail-box {
    background-color: rgb(44, 44, 44);

    max-width: 700px;

    width: 100%;

    padding: 40px;

    border-radius: 25px;

    text-align: left;

    box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.3);
}


.detail-box .job-icon {
    text-align: center;

    font-size: 70px;
}


.detail-box h1 {
    text-align: center;

    font-size: 40px;

    margin-bottom: 30px;
}


.detail-box h2 {
    margin-top: 30px;

    font-size: 24px;
}


.detail-box p {
    color: #cbd5e1;

    line-height: 1.8;

    font-size: 17px;
}


/* ==================== */
/* ĐIỆN THOẠI */
/* ==================== */

@media (max-width: 600px) {

    .home h1 {
        font-size: 32px;
    }


    .home p {
        font-size: 17px;
    }


    .jobs {
        padding: 40px 20px;
    }


    .jobs > h1 {
        font-size: 30px;
    }


    .job-container {
        grid-template-columns: 1fr;
    }


    .detail-box {
        padding: 25px;
    }


    .detail-box h1 {
        font-size: 32px;
    }

}
